# ─────────────────────────────────────────────────────────────────────────────
# RealEstateMagnet — Environment Configuration Template
# Copy to .env and fill in your values.  Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
SECRET_KEY=change-me-in-production
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── Database (PostgreSQL + PostGIS) ──────────────────────────────────────────
# Inside devcontainer: host is "db" (Docker service name)
# Outside devcontainer: host is "localhost"
POSTGRES_PASSWORD=rem_dev
DATABASE_URL=postgresql://rem:rem_dev@db:5432/realestate_magnet

# ── pgAdmin (devcontainer only) ───────────────────────────────────────────────
PGADMIN_EMAIL=admin@rem.local
PGADMIN_PASSWORD=admin

# ── Web Crawler ───────────────────────────────────────────────────────────────
CRAWL_DELAY_SECONDS=1.5      # Polite delay between requests
MAX_PAGES_PER_SOURCE=50      # Cap per web-protocol source
CRAWLER_USER_AGENT=RealEstateMagnet/0.1 (research; contact: admin@example.com)

# ── Optional: HTTP proxy for scraping ────────────────────────────────────────
# Uncomment and set if routing through a proxy (e.g., residential proxy service)
# HTTP_PROXY=http://user:pass@proxy.example.com:8080
# HTTPS_PROXY=http://user:pass@proxy.example.com:8080

# Optional: comma-separated proxy pool for ingestion (rotated on connection failure)
# PROXY_LIST=http://proxy1.example.com:8080,http://proxy2.example.com:8080

# ── Optional: Mapbox token (Phase 4 UI) ──────────────────────────────────────
# MAPBOX_PUBLIC_TOKEN=pk.eyJ1IjoiY2hhbmdlbWUi...

# ── Optional: Census API key ──────────────────────────────────────────────────
# https://api.census.gov/data/key_signup.html
# CENSUS_API_KEY=your-key-here

# ── Community Research (Workstream B) ───────────────────────────────────────
# Choose ONE of the following model providers:
#
# OPTION 1: Local model (llama.cpp + Qwen 27B)
#   - Start with: scripts/start-model-server.ps1
#   - Pros: Free, private, no rate limits
#   - Cons: Slower, requires ~17GB model download
#
MODEL_BASE_URL=http://localhost:8080/v1
MODEL_NAME=qwen3.8-27b
MODEL_API_KEY=local
MODEL_MAX_TOKENS=8192
#
# OPTION 2: Google Gemini (RECOMMENDED for best results)
#   - Get free API key: https://aistudio.google.com/apikey
#   - Pros: Much better quality, web search grounding (like browser Gemini)
#   - Cons: Free tier has rate limits (~15 req/min, 1500/day)
#
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MODEL_NAME=gemini-3.8-flash
# MODEL_API_KEY=your-gemini-api-key-here
# MODEL_MAX_TOKENS=8192
#
# OPTION 3: OpenAI
#   - Pros: High quality, reliable
#   - Cons: Paid (costs ~$0.01-0.03 per community researched)
#
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o
# MODEL_API_KEY=sk-your-openai-key-here
# MODEL_MAX_TOKENS=8192
#
# ── Search settings (used by research agent) ─────────────────────────────────
SEARCH_PROVIDER=duckduckgo      # only duckduckgo (ddgs) is implemented
RESEARCH_MAX_RESULTS=8          # search results per query
RESEARCH_PAGE_MAX_CHARS=8000    # page text truncation fed to the model

# ── Pipeline progress (console feedback for run-full-pipeline) ───────────────
# Seconds between "still working on <community> / <condenser>" heartbeat lines
# while a long condenser step runs. Set to 0 to disable.
PIPELINE_HEARTBEAT_SECONDS=30

# Stream the local model's reasoning ("thinking") to the pipeline console while
# each condenser runs. ON BY DEFAULT. Requires a reasoning-capable model server
# started with scripts/start-model-server.ps1. Disable with run-full-pipeline.ps1
# -NoThinking or by setting this to 0. (This file is not auto-loaded by the
# pipeline — export the variable or use the launcher switch.)
PIPELINE_SHOW_THINKING=1

# ── AI Condenser (Workstream B — fast data gathering) ───────────────────────
# The condenser uses AI knowledge to quickly populate the community database.
# Configure MODEL_* above to point at the desired API:
#
# Local model (default):
#   MODEL_BASE_URL=http://localhost:8080/v1
#   MODEL_NAME=qwen3.8-27b
#   MODEL_API_KEY=local
#
# Google Gemini (get key at https://aistudio.google.com/apikey):
#   MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/v1
#   MODEL_NAME=gemini-2.5-flash
#   MODEL_API_KEY=your-gemini-api-key
#
# OpenAI:
#   MODEL_BASE_URL=https://api.openai.com/v1
#   MODEL_NAME=gpt-4o
#   MODEL_API_KEY=sk-...
#
CONDENSER_BATCH_SIZE=20         # communities per batch query

# ── Browser Condenser (Workstream B — browser-based discovery) ──────────────
# The browser condenser uses Playwright to automate Chrome/Edge for Google searches,
# then uses the local model to extract structured community data from search results.
# Iteratively analyzes gaps in collected data and generates targeted queries.
#
# Chrome profile path (reuses existing Chrome login session):
#   Windows: %LOCALAPPDATA%\Google\Chrome\User Data
#   Linux: ~/.config/google-chrome
#   Leave empty to auto-detect or use a fresh profile
CHROME_PROFILE_PATH=
#
# Browser settings:
BROWSER_HEADLESS=false          # Run browser in headless mode (true for CI, false for debugging)
BROWSER_DELAY_SEARCHES=2.0      # Delay between Google searches (seconds)
BROWSER_DELAY_PAGES=1.0         # Delay between page reads (seconds)
BROWSER_MAX_PAGES_PER_QUERY=3   # Max pages to read per search query
BROWSER_MAX_ITERATIONS=20       # Max iterations before stopping
BROWSER_SAVE_INTERVAL=1         # Save state every N iterations

# Visible-browser CAPTCHA handling (read_page PDF fallback):
# How long to keep one visible browser session open on a CAPTCHA so a human can
# solve it (seconds). The challenge is polled in the SAME session — there is no
# relaunch/retry. Set to 0 to give up immediately.
CAPTCHA_MANUAL_WAIT_SECONDS=60
